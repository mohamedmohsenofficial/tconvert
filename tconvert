#!/usr/bin/env bash

# --- VERSION CONTROL ---
VERSION="1.0.6"
REPO_URL="https://raw.githubusercontent.com/mohamedmohsenofficial/tconvert/main/tconvert"

BOLD='\033[1m'
RED='\033[1;31m'
WHITE='\033[1;37m'
GRAY='\033[1;30m'
YELLOW='\033[1;33m'
GREEN='\033[1;32m'
BLUE='\033[1;34m'
CYAN='\033[1;36m'
MAGENTA='\033[1;35m'
NC='\033[0m'

clear

printf "${BOLD}${RED}"
cat << "EOF"
 _____ ____ ___  _   ___     _______ ____ _____ 
|_   _/ ___/ _ \| \ | \ \   / / ____|  _ \_   _|
  | || |  | | | |  \| |\ \ / /|  _| | |_) || |  
  | || |__| |_| | |\  | \ V / | |___|  _ < | |  
  |_| \____\___/|_| \_|  \_/  |_____|_| \_\|_|  
EOF
printf "${NC}\n"

printf "${WHITE}Introducing TConvert, the world’s most private and lightning-fast local file converter. It empowers you to convert absolutely any file type in mere seconds with just 4 keystrokes—100%% free, and with no need to install complex, resource-heavy, or bloated software. By running entirely offline directly on your personal machine, TConvert guarantees maximum security and absolute privacy for your data. It’s so secure and reliable, you could comfortably process Obama and Trump's classified work files on it without batting an eye! 🛡️${NC}\n\n"

printf " Designed with :   ${BOLD}Mohamed Mohsen${NC} & the amazing open-source community!  ❤️\n\n"
printf " GitHub :          ${CYAN}https://github.com/mohamedmohsenofficial/tconvert${NC}\n\n"
printf " LinkedIn :        ${CYAN}https://linkedin.com/in/mohamedmohsenofficial${NC}\n\n"
printf " Version :         ${YELLOW}v${VERSION}${NC}\n\n"
sleep 0.5

printf "${CYAN}Checking for updates... ${NC}"
REMOTE_VERSION=$(curl -s --max-time 5 "$REPO_URL" | grep -m 1 '^VERSION=' | cut -d'"' -f2)

if [[ -z "$REMOTE_VERSION" ]]; then
    printf "${YELLOW}Could not connect. Working offline.${NC}\n\n"
    printf "${GRAY}( Internet is only for updates, conversion is 100%% offline! )${NC}\n\n"
elif [[ "$REMOTE_VERSION" != "$VERSION" ]]; then
    printf "\n${YELLOW}🚀 New version available: v${REMOTE_VERSION} (Current: v${VERSION})${NC}\n\n"
    printf "🤔 Do you want to install the update now? (y/n): "
    read UPDATE_CHOICE
    if [[ "$UPDATE_CHOICE" =~ ^[Yy]$ ]]; then
        printf "\n${MAGENTA}📥 Downloading update...${NC}\n"
        TEMP_FILE="/tmp/tconvert_update"
        if curl -s -o "$TEMP_FILE" "$REPO_URL"; then
            chmod +x "$TEMP_FILE"
            printf "${YELLOW}🔑 Admin privileges might be required to apply the update.${NC}\n"
            sudo mv "$TEMP_FILE" "$0"
            printf "${GREEN}😊 Update successful! Restarting TConvert...${NC}\n\n"
            sleep 1
            exec "$0" "$@"
        else
            printf "${RED}❌ Update failed. Please try again later.${NC}\n\n"
        fi
    else
        printf "\n${GREEN}😊 Continuing with current version...${NC}\n\n"
    fi
else
    printf "${GREEN}Up to date 😊${NC}\n\n"
fi

CHECK_FILE="$HOME/.tconvert_deps_checked"

if [ ! -f "$CHECK_FILE" ]; then
  printf "${CYAN}🔍 Running System Health Check...${NC} "
  sleep 1

  MISSING_DEPS=()
  if ! command -v ffmpeg &> /dev/null; then MISSING_DEPS+=("ffmpeg (For Video & Audio)"); fi
  if ! command -v magick &> /dev/null; then MISSING_DEPS+=("imagemagick (For Images)"); fi
  if ! command -v libreoffice &> /dev/null; then MISSING_DEPS+=("libreoffice (For Documents)"); fi
  if ! command -v ebook-convert &> /dev/null; then MISSING_DEPS+=("calibre (For E-books)"); fi
  if ! command -v pandoc &> /dev/null; then MISSING_DEPS+=("pandoc (For Text/Markdown)"); fi

  if [ ${#MISSING_DEPS[@]} -ne 0 ]; then
    printf "\n\n${YELLOW}⚠️ NOTICE: SOME ENGINES ARE MISSING${NC}\n"
    printf "${WHITE}TConvert acts as a central commander. You can still proceed and use the tool for the engines you already have, but the following are missing:${NC}\n\n"
    
    for dep in "${MISSING_DEPS[@]}"; do
      printf " ❌ ${RED}%s${NC}\n" "$dep"
    done
    
    printf "\n🤔 Do you want to continue with the installed engines only? (y/n): "
    read CONTINUE_CHOICE
    
    if [[ "$CONTINUE_CHOICE" =~ ^[Yy]$ ]]; then
      printf "\n${GREEN}😊 OK! We will skip this check in the future.${NC}\n\n"
      touch "$CHECK_FILE"
      sleep 0.5
    else
      printf "\n${WHITE}Please head back to the GitHub page for installation instructions:${NC}\n"
      printf "${BLUE}https://github.com/mohamedmohsenofficial/tconvert#%EF%B8%8F-critical-notice-dependencies-required-first${NC}\n\n"
      exit 1
    fi
  else
    printf "${GREEN}😊 All engines are locked and loaded! 🚀${NC}\n\n"
    touch "$CHECK_FILE"
    sleep 0.5
  fi
fi

printf "${BOLD}📁 Enter file name (with extension): ${NC}"
read FILE

printf "\n${MAGENTA}🔍 Analyzing file...${NC}\n\n"
sleep 0.8

if [ ! -f "$FILE" ]; then
  printf "${RED}❌ Error: File '%s' not found! Are you sure the name is correct?${NC}\n" "$FILE"
  exit 1
fi

# SAFE EXTENSION EXTRACTION (Supports tar.gz, tar.xz)
LOWER_FILE=$(echo "$FILE" | tr '[:upper:]' '[:lower:]')
if [[ "$LOWER_FILE" == *.tar.gz ]]; then
  EXT="tar.gz"
  FILENAME="${FILE%.*}"
  FILENAME="${FILENAME%.*}"
elif [[ "$LOWER_FILE" == *.tar.bz2 ]]; then
  EXT="tar.bz2"
  FILENAME="${FILE%.*}"
  FILENAME="${FILENAME%.*}"
elif [[ "$LOWER_FILE" == *.tar.xz ]]; then
  EXT="tar.xz"
  FILENAME="${FILE%.*}"
  FILENAME="${FILENAME%.*}"
else
  EXT="${FILE##*.}"
  FILENAME="${FILE%.*}"
fi
EXT=$(echo "$EXT" | tr '[:upper:]' '[:lower:]')

TYPE=""
declare -a SUGGESTIONS

# Bulletproof Engine Mapping (Strictly what we can convert NOW)
case "$EXT" in
  pdf|pdf/a)
    TYPE="document"
    SUGGESTIONS=(jpg png bmp tiff webp) # Magick extracts PDF pages to images
    ;;
  doc|docx|odt)
    TYPE="document"
    SUGGESTIONS=(pdf odt html txt epub rtf)
    ;;
  xls|xlsx|ods|csv|tsv)
    TYPE="spreadsheet"
    SUGGESTIONS=(pdf xlsx ods csv html txt)
    ;;
  ppt|pptx|odp)
    TYPE="presentation"
    SUGGESTIONS=(pdf odp html txt)
    ;;
  mp4|mkv|avi|mov|webm|flv|wmv|3gp|ts|m4v|mpeg|ogv|asf|f4v)
    TYPE="video"
    SUGGESTIONS=(3gp aac ac3 aiff asf avi flac flv gif m4a m4v mka mkv mov mp2 mp3 mp4 mpeg oga ogv opus ts wav webm wma wmv)
    ;;
  mp3|wav|flac|m4a|aac|ogg|wma|opus|aa3|ac3|aiff|mka|mp2|oga|oma)
    TYPE="audio"
    SUGGESTIONS=(aac ac3 aiff flac m4a mka mp2 mp3 oga opus wav wma)
    ;;
  jpg|jpeg|png|webp|bmp|gif|tiff|ico|heic|svg|heif|apng|avif)
    TYPE="image"
    SUGGESTIONS=(apng bmp dds dib eps gif heic heif icns ico jp2 jpeg jxl pbm pcx pfm pgm png pnm ppm psd sgi svg tga tiff webp xbm xpm pdf)
    ;;
  epub|mobi|azw3|fb2|kepub|lrf|pdb|snb)
    TYPE="ebook"
    SUGGESTIONS=(azw3 docx epub fb2 html lrf mobi odt pdb pdf rtf snb txt)
    ;;
  md|txt|rtf|adoc|xml|tex)
    TYPE="text"
    SUGGESTIONS=(adoc docx epub html md odt pdf rtf tex txt)
    ;;
  zip|cbz|tar|tar.gz|tar.bz2|tar.xz|tgz)
    TYPE="archive"
    SUGGESTIONS=(zip cbz tar tar.gz tar.bz2 tar.xz)
    ;;
  *)
    TYPE="unknown"
    SUGGESTIONS=(mp4 mp3 jpg pdf zip docx png mkv csv html)
    ;;
esac

printf "${GREEN}😊 File detected as: ${TYPE} ✨${NC}\n\n"
sleep 0.5

printf "${BOLD}${CYAN}⚙  What do you want to do?${NC}\n\n"
printf "  1) Convert to a new format and Compression ( optional ) 🎭\n\n"
printf "  2) Compress only ( Keep original format ) 📦\n\n"
printf "🤔 Enter choice (1 or 2): "
read ACTION_CHOICE
printf "\n${GREEN}😊 Got it!${NC}\n\n"
sleep 0.5

DO_COMPRESS="n"
COMP_METHOD=""

if [ "$ACTION_CHOICE" == "1" ]; then
  printf "${BOLD}${WHITE}📌 Suggested formats for this file:${NC}\n\n"
  
  for i in "${!SUGGESTIONS[@]}"; do
    printf "  %d. %s\n" $((i+1)) "${SUGGESTIONS[$i]}"
  done
  printf "  0. Type a custom format manually\n\n"

  printf "🤔 Enter the NUMBER of your choice: "
  read CHOICE
  
  printf "\n${MAGENTA}🧠 Thinking...${NC}\n\n"
  sleep 1.2

  if [[ "$CHOICE" =~ ^[0-9]+$ ]] && [ "$CHOICE" -gt 0 ] && [ "$CHOICE" -le "${#SUGGESTIONS[@]}" ]; then
    TARGET_EXT="${SUGGESTIONS[$((CHOICE-1))]}"
  elif [ "$CHOICE" == "0" ]; then
    printf "🎯 Type the format manually (e.g. mp4): "
    read TARGET_EXT
  else
    TARGET_EXT="$CHOICE"
  fi
  
  TARGET_EXT=${TARGET_EXT#.}
  TARGET_EXT=$(echo "$TARGET_EXT" | tr '[:upper:]' '[:lower:]')
  printf "\n${GREEN}😊 Excellent choice!${NC}\n\n"
  sleep 0.5

  if [[ "$TYPE" == "video" || "$TYPE" == "audio" || "$TYPE" == "image" ]]; then
    printf "📦 Do you want to compress the file? (y/n): "
    read DO_COMPRESS
    printf "\n${GREEN}😊 OK${NC}\n\n"
  fi

elif [ "$ACTION_CHOICE" == "2" ]; then
  TARGET_EXT="$EXT"
  if [[ "$TYPE" == "video" || "$TYPE" == "audio" || "$TYPE" == "image" ]]; then
    DO_COMPRESS="y"
  else
    printf "${YELLOW}⚠️ Compression is not supported for %s files. Just duplicating.${NC}\n\n" "$TYPE"
    DO_COMPRESS="n"
  fi
else
  printf "${RED}❌ Invalid choice!${NC}\n"
  exit 1
fi

if [[ "$DO_COMPRESS" =~ ^[Yy]$ ]]; then
  printf "${BOLD}${CYAN}⚙️  Choose compression method:${NC}\n\n"
  printf "  1) By Percentage (%%) 📉\n\n"
  printf "  2) By Target Size (MB) 💾\n\n"
  printf "🤔 Enter choice (1 or 2): "
  read COMP_METHOD
  printf "\n${GREEN}😊 OK${NC}\n\n"
  sleep 0.5

  if [ "$COMP_METHOD" == "1" ]; then
    printf "${BOLD}${CYAN}⚙️  Choose compression level:${NC}\n\n"
    printf "  1) High Quality (Light compression ~ 20%%) 🟢\n\n"
    printf "  2) Medium Quality (Balanced ~ 50%%) 🟡\n\n"
    printf "  3) Low Quality (Heavy compression ~ 80%%) 🔴\n\n"
    printf "  0) Custom Percentage ✍️\n\n"
    printf "🤔 Enter choice (0-3): "
    read COMP_CHOICE
    printf "\n${GREEN}😊 OK${NC}\n\n"

    case "$COMP_CHOICE" in
      1) COMP_PERCENT=20 ;;
      2) COMP_PERCENT=50 ;;
      3) COMP_PERCENT=80 ;;
      0) printf "📉 Enter custom compression percentage (1-100): "; read COMP_PERCENT; printf "\n${GREEN}😊 OK${NC}\n\n" ;;
      *) printf "⚠️ Invalid. Defaulting to 50%%.\n\n"; COMP_PERCENT=50 ;;
    esac
  elif [ "$COMP_METHOD" == "2" ]; then
    printf "💾 Enter target size in Megabytes (MB): "
    read TARGET_MB
    printf "\n${GREEN}😊 OK${NC}\n\n"
  else
    printf "${YELLOW}⚠️ Invalid choice. Skipping compression.${NC}\n\n"
  fi
fi

OUTPUT_FILE="${FILENAME}_tconvert.${TARGET_EXT}"
CMD=""
ARGS=""

IS_TARGET_AUDIO=false
if [[ "mp3 wav flac m4a aac ogg wma opus" =~ "$TARGET_EXT" ]]; then
  IS_TARGET_AUDIO=true
fi

TOTAL_SEC=0
USE_REAL_PROGRESS=false
FFMPEG_LOG="/tmp/ffmpeg_progress.log"
rm -f "$FFMPEG_LOG"

printf "${MAGENTA}⚙️  Preparing engines...${NC}\n\n"
sleep 1

# ==========================================
# BULLETPROOF ENGINE ROUTING (Strict matching)
# ==========================================

# 1. FFmpeg (Video/Audio)
if [[ " 3gp aac ac3 aiff apng asf avi f4v flac flv m4a m4v mka mkv mov mp2 mp3 mp4 mpeg oga ogv opus ts wav webm wma wmv " =~ " $TARGET_EXT " ]] && [[ "$TYPE" == "video" || "$TYPE" == "audio" ]]; then
  if [ "$IS_TARGET_AUDIO" = true ] && [ "$EXT" != "$TARGET_EXT" ]; then
    ARGS="-vn "
  fi

  if command -v ffprobe &> /dev/null; then
    TOTAL_SEC=$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$FILE" 2>/dev/null | awk '{print int($1)}')
    if [[ -n "$TOTAL_SEC" && "$TOTAL_SEC" -gt 0 ]]; then
      USE_REAL_PROGRESS=true
    fi
  fi

  if [[ "$DO_COMPRESS" =~ ^[Yy]$ ]]; then
    if [ "$COMP_METHOD" == "1" ] && [ -n "$COMP_PERCENT" ]; then
      if [ "$IS_TARGET_AUDIO" = false ]; then
        CRF=$(( 18 + (COMP_PERCENT * 33 / 100) ))
        ARGS+="-c:v libx264 -crf $CRF -preset fast"
      else
        BR=$(( 64 + ((100 - COMP_PERCENT) * 256 / 100) ))
        ARGS+="-b:a ${BR}k"
      fi
    elif [ "$COMP_METHOD" == "2" ] && [ -n "$TARGET_MB" ]; then
      if [ "$USE_REAL_PROGRESS" = true ]; then
        TOTAL_BITRATE=$(( (TARGET_MB * 8192) / TOTAL_SEC ))
        if [ "$IS_TARGET_AUDIO" = false ]; then
          V_BITRATE=$(( TOTAL_BITRATE - 128 ))
          if [ $V_BITRATE -lt 50 ]; then V_BITRATE=50; fi
          ARGS+="-b:v ${V_BITRATE}k -maxrate ${V_BITRATE}k -bufsize $((V_BITRATE*2))k -b:a 128k"
        else
          ARGS+="-b:a ${TOTAL_BITRATE}k"
        fi
      else
        ARGS+="-c:v libx264 -crf 30 -preset fast"
      fi
    fi
  fi
  
  if [ "$USE_REAL_PROGRESS" = true ]; then
    CMD="ffmpeg -i \"$FILE\" $ARGS -progress \"$FFMPEG_LOG\" -nostats \"$OUTPUT_FILE\" -y"
  else
    CMD="ffmpeg -i \"$FILE\" $ARGS \"$OUTPUT_FILE\" -y"
  fi

# 2. ImageMagick (Images)
elif [[ " apng bmp dds dib eps gif heic heif icns ico jp2 jpeg jxl pbm pcx pfm pgm png pnm ppm psd sgi svg tga tiff webp xbm xpm pdf " =~ " $TARGET_EXT " ]] && [[ "$TYPE" == "image" || "$EXT" == "pdf" ]]; then
  if [[ "$DO_COMPRESS" =~ ^[Yy]$ ]]; then
    if [ "$COMP_METHOD" == "1" ] && [ -n "$COMP_PERCENT" ]; then
      QUAL=$(( 100 - COMP_PERCENT ))
      if [ "$QUAL" -lt 1 ]; then QUAL=1; fi
      ARGS="-quality $QUAL"
    elif [ "$COMP_METHOD" == "2" ] && [ -n "$TARGET_MB" ]; then
      ARGS="-define jpeg:extent=${TARGET_MB}MB -define webp:extent=${TARGET_MB}MB"
    fi
  fi
  CMD="magick -density 300 \"$FILE\" $ARGS \"$OUTPUT_FILE\""

# 3. Native Linux Archive (Zip/Tar)
elif [[ " zip cbz tar tar.gz tar.bz2 tar.xz tgz " =~ " $TARGET_EXT " ]]; then
  if [[ "$FILE" = /* ]]; then ABS_FILE="$FILE"; else ABS_FILE="$PWD/$FILE"; fi
  if [[ "$OUTPUT_FILE" = /* ]]; then ABS_OUTPUT="$OUTPUT_FILE"; else ABS_OUTPUT="$PWD/$OUTPUT_FILE"; fi
  
  CMD="TEMP_DIR=\$(mktemp -d) && "
  
  if [[ "$EXT" == "zip" || "$EXT" == "cbz" ]]; then
    CMD+="unzip -q \"\$ABS_FILE\" -d \"\$TEMP_DIR\" && "
  elif [[ "$EXT" == "tar" ]]; then
    CMD+="tar -xf \"\$ABS_FILE\" -C \"\$TEMP_DIR\" && "
  elif [[ "$EXT" == "tar.gz" || "$EXT" == "tgz" ]]; then
    CMD+="tar -xzf \"\$ABS_FILE\" -C \"\$TEMP_DIR\" && "
  elif [[ "$EXT" == "tar.bz2" ]]; then
    CMD+="tar -xjf \"\$ABS_FILE\" -C \"\$TEMP_DIR\" && "
  elif [[ "$EXT" == "tar.xz" ]]; then
    CMD+="tar -xJf \"\$ABS_FILE\" -C \"\$TEMP_DIR\" && "
  fi

  CMD+="(cd \"\$TEMP_DIR\" && "
  if [[ "$TARGET_EXT" == "zip" || "$TARGET_EXT" == "cbz" ]]; then
    CMD+="zip -rq \"\$ABS_OUTPUT\" .) && rm -rf \"\$TEMP_DIR\""
  elif [[ "$TARGET_EXT" == "tar" ]]; then
    CMD+="tar -cf \"\$ABS_OUTPUT\" .) && rm -rf \"\$TEMP_DIR\""
  elif [[ "$TARGET_EXT" == "tar.gz" || "$TARGET_EXT" == "tgz" ]]; then
    CMD+="tar -czf \"\$ABS_OUTPUT\" .) && rm -rf \"\$TEMP_DIR\""
  elif [[ "$TARGET_EXT" == "tar.bz2" ]]; then
    CMD+="tar -cjf \"\$ABS_OUTPUT\" .) && rm -rf \"\$TEMP_DIR\""
  elif [[ "$TARGET_EXT" == "tar.xz" ]]; then
    CMD+="tar -cJf \"\$ABS_OUTPUT\" .) && rm -rf \"\$TEMP_DIR\""
  fi

# 4. Calibre (E-books)
elif [[ " epub mobi azw3 fb2 kepub lrf pdb snb " =~ " $TARGET_EXT " ]] || [[ "$TYPE" == "ebook" && " epub mobi azw3 fb2 kepub lrf pdb snb docx rtf txt pdf " =~ " $TARGET_EXT " ]]; then
  CMD="ebook-convert \"$FILE\" \"$OUTPUT_FILE\""

# 5. Pandoc & LibreOffice (Documents, Spreadsheets, Text)
elif [[ " docx odt xlsx ods csv tsv pptx odp pdf html xml rtf txt md tex " =~ " $TARGET_EXT " ]]; then
  if [[ "$TYPE" == "text" ]]; then
    CMD="pandoc \"$FILE\" -o \"$OUTPUT_FILE\""
  else
    printf "${MAGENTA}🔄 Converting document/spreadsheet...${NC}\n"
    CMD="libreoffice --headless --convert-to $TARGET_EXT --outdir . \"$FILE\""
    OUTPUT_FILE="${FILENAME}.${TARGET_EXT}"
  fi

else
  printf "${RED}❌ Error: Format engine routing failed. Target format not currently supported.${NC}\n"
  exit 1
fi

ERROR_LOG="/tmp/tconvert_error.log"
eval $CMD > "$ERROR_LOG" 2>&1 &
PID=$!

bar_width=30
frames=("⏳" "⌛")

if [ "$USE_REAL_PROGRESS" = true ]; then
  f_idx=0
  while kill -0 $PID 2>/dev/null; do
    if [ -f "$FFMPEG_LOG" ]; then
      CURRENT_US=$(grep "out_time_us=" "$FFMPEG_LOG" | tail -n 1 | cut -d '=' -f 2)
      if [[ -n "$CURRENT_US" && "$CURRENT_US" =~ ^[0-9]+$ ]]; then
        CURRENT_SEC=$(( CURRENT_US / 1000000 ))
        PCT=$(( (CURRENT_SEC * 100) / TOTAL_SEC ))
        if [ "$PCT" -gt 100 ]; then PCT=100; fi
        if [ "$PCT" -lt 0 ]; then PCT=0; fi
        
        filled_len=$(( PCT * bar_width / 100 ))
        empty_len=$(( bar_width - filled_len ))
        
        filled=""
        [ $filled_len -gt 0 ] && filled=$(printf "%${filled_len}s" | tr ' ' '█')
        empty=""
        [ $empty_len -gt 0 ] && empty=$(printf "%${empty_len}s" | tr ' ' '░')
        
        if [ "$PCT" -le 25 ]; then
            P_COLOR=$RED; P_ICON="🔴"
        elif [ "$PCT" -le 50 ]; then
            P_COLOR=$YELLOW; P_ICON="🟡"
        elif [ "$PCT" -le 75 ]; then
            P_COLOR=$BLUE; P_ICON="🔵"
        else
            P_COLOR=$GREEN; P_ICON="🟢"
        fi

        anim=${frames[$((f_idx % ${#frames[@]}))]}
        
        printf "\r${CYAN}🚀 Converting: [${P_COLOR}%s${GRAY}%s${CYAN}] %3d%% ${anim} ${NC}\033[K" "$filled" "$empty" "$PCT"
      fi
    fi
    f_idx=$((f_idx + 1))
    sleep 0.5
  done
else
  h_idx=0
  while kill -0 $PID 2>/dev/null; do
    anim=${frames[$((h_idx % ${#frames[@]}))]}
    printf "\r${CYAN}🚀 Converting... %s (Please wait) ${NC}\033[K" "$anim"
    h_idx=$((h_idx + 1))
    sleep 0.2
  done
fi

wait $PID
EXIT_CODE=$?

printf "\r\033[K"

if [ $EXIT_CODE -eq 0 ]; then
  printf "\n${GREEN}🎉 Conversion Completed Successfully!${NC}\n\n"
  printf "${WHITE}📄 Output File:${NC}\n"
  printf "${BOLD}${BLUE}%s${NC}\n\n" "$OUTPUT_FILE"
  rm -f "$ERROR_LOG" "$FFMPEG_LOG"
else
  printf "\n${RED}❌ Error: Conversion failed.${NC}\n\n"
  printf "Check details below:\n"
  cat "$ERROR_LOG"
fi
