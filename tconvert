#!/usr/bin/env bash

# --- VERSION CONTROL ---
VERSION="2.0.1"
REPO_URL="https://raw.githubusercontent.com/mohamedmohsenofficial/tconvert/main/tconvert"

BOLD='\033[1m'
RED='\033[1;31m'
WHITE='\033[1;37m'
GRAY='\033[1;30m'
YELLOW='\033[1;33m'
GREEN='\033[1;32m'
BLUE='\033[1;34m'
CYAN='\033[1;36m'
MAGENTA='\033[1;35m'
NC='\033[0m'

clear

printf "${BOLD}${RED}"
cat << "EOF"
 _____ ____ ___  _   ___    _______ ____ _____ 
|_   _/ ___/ _ \| \ | \ \   / / ____|  _ \_   _|
  | || |  | | | |  \| |\ \ / /|  _| | |_) || |  
  | || |__| |_| | |\  | \ V / | |___|  _ < | |  
  |_| \____\___/|_| \_|  \_/  |_____|_| \_\|_|  
EOF
printf "${NC}\n"

printf "${WHITE}Welcome to TConvert. A fast, offline local file converter. Convert files directly on your machine with absolute privacy.\n${NC}\n"
printf " Designed with :   ${BOLD}Mohamed Mohsen${NC} & the open-source community\n"
printf " GitHub :          ${CYAN}https://github.com/mohamedmohsenofficial/tconvert${NC}\n"
printf " LinkedIn :        ${CYAN}https://linkedin.com/in/mohsenofficial${NC}\n"
printf " Version :         ${YELLOW}v${VERSION} ${RED}- Python Data Engine enabled${NC}\n\n"
sleep 0.5

printf "${CYAN}Checking for updates... ${NC}"
REMOTE_VERSION=$(curl -s --max-time 5 "$REPO_URL" | grep -m 1 '^VERSION=' | cut -d'"' -f2)

if [[ -z "$REMOTE_VERSION" ]]; then
    printf "${YELLOW}Could not connect. Working offline.${NC}\n\n"
elif [[ "$REMOTE_VERSION" != "$VERSION" ]]; then
    printf "\n${YELLOW}New version available: v${REMOTE_VERSION} ${RED}- Current: v${VERSION}${NC}\n\n"
    printf "Do you want to install the update now? ${RED}- y/n:${NC} "
    read UPDATE_CHOICE
    if [[ "$UPDATE_CHOICE" =~ ^[Yy]$ ]]; then
        printf "\n${MAGENTA}Downloading update...${NC}\n"
        TEMP_FILE="/tmp/tconvert_update"
        if curl -s -o "$TEMP_FILE" "$REPO_URL"; then
            chmod +x "$TEMP_FILE"
            printf "${YELLOW}Admin privileges might be required to apply the update.${NC}\n"
            sudo mv "$TEMP_FILE" "$0"
            printf "${GREEN}Update successful. Restarting TConvert...${NC}\n\n"
            sleep 1
            exec "$0" "$@"
        else
            printf "${RED}Update failed. Please try again later.${NC}\n\n"
        fi
    else
        printf "\n${GREEN}Continuing with current version...${NC}\n\n"
    fi
else
    printf "${GREEN}Up to date.${NC}\n\n"
fi

CHECK_FILE="$HOME/.tconvert_deps_checked_v2"

if [ ! -f "$CHECK_FILE" ]; then
  printf "${CYAN}Running System Health Check...${NC} "
  sleep 1

  MISSING_DEPS=()
  if ! command -v ffmpeg &> /dev/null; then MISSING_DEPS+=("ffmpeg ${RED}- For Video & Audio${NC}"); fi
  if ! command -v magick &> /dev/null; then MISSING_DEPS+=("imagemagick ${RED}- For Images${NC}"); fi
  if ! command -v libreoffice &> /dev/null; then MISSING_DEPS+=("libreoffice ${RED}- For Documents${NC}"); fi
  if ! command -v ebook-convert &> /dev/null; then MISSING_DEPS+=("calibre ${RED}- For E-books${NC}"); fi
  if ! command -v pandoc &> /dev/null; then MISSING_DEPS+=("pandoc ${RED}- For Text${NC}"); fi
  if ! python3 -c "import pandas" &> /dev/null; then MISSING_DEPS+=("python3-pandas ${RED}- For Data: JSON, Parquet, etc${NC}"); fi

  if [ ${#MISSING_DEPS[@]} -ne 0 ]; then
    printf "\n\n${YELLOW}NOTICE: SOME ENGINES ARE MISSING${NC}\n"
    printf "${WHITE}TConvert acts as a central commander. You can still proceed and use the tool for the engines you already have, but the following are missing:${NC}\n\n"
    
    for dep in "${MISSING_DEPS[@]}"; do
      printf " - ${RED}%s${NC}\n" "$dep"
    done
    
    printf "\n${GRAY}Tip for Data Engine: pip install pandas openpyxl pyarrow lxml${NC}\n"
    printf "\nDo you want to continue with the installed engines only? ${RED}- y/n:${NC} "
    read CONTINUE_CHOICE
    
    if [[ "$CONTINUE_CHOICE" =~ ^[Yy]$ ]]; then
      printf "\n${GREEN}Understood. We will skip this check in the future.${NC}\n\n"
      touch "$CHECK_FILE"
      sleep 0.5
    else
      printf "\n${WHITE}Please head back to the GitHub page for installation instructions:${NC}\n"
      printf "${BLUE}https://github.com/mohamedmohsenofficial/tconvert#%EF%B8%8F-critical-notice-dependencies-required-first${NC}\n\n"
      exit 1
    fi
  else
    printf "${GREEN}All engines are installed and ready.${NC}\n\n"
    touch "$CHECK_FILE"
    sleep 0.5
  fi
fi

# Main Application Loop
while true; do

  # Reset variables per loop iteration
  DO_COMPRESS="n"
  COMP_METHOD=""
  COMP_PERCENT=""
  TARGET_KB=""
  TARGET_MB=""
  ADV_MUTE=false
  ADV_AUDIO_ONLY_COMPRESS=false
  ADV_PRESERVE_FPS=false
  ADV_TRIM=false
  TRIM_START=0
  TRIM_END=0

  printf "${BOLD}Enter file name ${RED}- with extension:${NC} "
  read FILE

  printf "\n${MAGENTA}Analyzing file...${NC}\n\n"
  sleep 0.8

  if [ ! -f "$FILE" ]; then
    printf "${RED}Error: File '%s' not found. Please verify the name and path.${NC}\n\n" "$FILE"
    continue
  fi

  LOWER_FILE=$(echo "$FILE" | tr '[:upper:]' '[:lower:]')
  if [[ "$LOWER_FILE" == *.tar.gz ]]; then
    EXT="tar.gz"
    FILENAME="${FILE%.*}"
    FILENAME="${FILENAME%.*}"
  elif [[ "$LOWER_FILE" == *.tar.bz2 ]]; then
    EXT="tar.bz2"
    FILENAME="${FILE%.*}"
    FILENAME="${FILENAME%.*}"
  elif [[ "$LOWER_FILE" == *.tar.xz ]]; then
    EXT="tar.xz"
    FILENAME="${FILE%.*}"
    FILENAME="${FILENAME%.*}"
  else
    EXT="${FILE##*.}"
    FILENAME="${FILE%.*}"
  fi
  EXT=$(echo "$EXT" | tr '[:upper:]' '[:lower:]')

  TYPE=""
  declare -a SUGGESTIONS

  case "$EXT" in
    pdf|pdf/a)
      TYPE="document"
      SUGGESTIONS=(jpg png bmp tiff webp epub mobi azw3)
      ;;
    doc|docx|odt)
      TYPE="document"
      SUGGESTIONS=(pdf odt html txt epub rtf)
      ;;
    ppt|pptx|odp)
      TYPE="presentation"
      SUGGESTIONS=(pdf odp html txt)
      ;;
    xls|xlsx|ods|csv|tsv)
      TYPE="spreadsheet"
      SUGGESTIONS=(pdf csv tsv json jsonl parquet html md xml xlsx)
      ;;
    json|jsonl|parquet|xml)
      TYPE="data"
      SUGGESTIONS=(csv tsv json jsonl parquet xlsx html md xml)
      ;;
    mp4|mkv|avi|mov|webm|flv|wmv|3gp|ts|m4v|mpeg|ogv|asf|f4v)
      TYPE="video"
      SUGGESTIONS=(3gp aac ac3 aiff asf avi flac flv gif m4a m4v mka mkv mov mp2 mp3 mp4 mpeg oga ogv opus ts wav webm wma wmv)
      ;;
    mp3|wav|flac|m4a|aac|ogg|wma|opus|aa3|ac3|aiff|mka|mp2|oga|oma)
      TYPE="audio"
      SUGGESTIONS=(aac ac3 aiff flac m4a mka mp2 mp3 oga opus wav wma)
      ;;
    jpg|jpeg|png|webp|bmp|gif|tiff|ico|heic|svg|heif|apng|avif)
      TYPE="image"
      SUGGESTIONS=(apng bmp dds dib eps gif heic heif icns ico jp2 jpeg jxl pbm pcx pfm pgm png pnm ppm psd sgi svg tga tiff webp xbm xpm pdf)
      ;;
    epub|mobi|azw3|fb2|kepub|lrf|pdb|snb)
      TYPE="ebook"
      SUGGESTIONS=(azw3 docx epub fb2 html lrf mobi odt pdb pdf rtf snb txt)
      ;;
    md|txt|rtf|adoc|tex)
      TYPE="text"
      SUGGESTIONS=(adoc docx epub html md odt pdf rtf tex txt)
      ;;
    zip|cbz|tar|tar.gz|tar.bz2|tar.xz|tgz)
      TYPE="archive"
      SUGGESTIONS=(zip cbz tar tar.gz tar.bz2 tar.xz)
      ;;
    *)
      TYPE="unknown"
      SUGGESTIONS=(mp4 mp3 jpg pdf zip docx png mkv csv json)
      ;;
  esac

  printf "${GREEN}File detected as: ${TYPE}${NC}\n\n"
  sleep 0.5

  printf "${BOLD}${CYAN}What would you like to do?${NC}\n\n"
  printf "  1. Convert to a new format ${RED}- and optionally compress${NC}\n\n"
  printf "  2. Compress only ${RED}- keep original format${NC}\n\n"
  printf "Choice: "
  read ACTION_CHOICE
  printf "\n"

  if [ "$ACTION_CHOICE" == "1" ]; then
    printf "${BOLD}${WHITE}Suggested formats for this file:${NC}\n\n"
    
    for i in "${!SUGGESTIONS[@]}"; do
      printf "  %d. %s\n\n" $((i+1)) "${SUGGESTIONS[$i]}"
    done
    printf "  0. Type a custom format manually\n\n"

    printf "Choice: "
    read CHOICE
    
    if [[ "$CHOICE" =~ ^[0-9]+$ ]] && [ "$CHOICE" -gt 0 ] && [ "$CHOICE" -le "${#SUGGESTIONS[@]}" ]; then
      TARGET_EXT="${SUGGESTIONS[$((CHOICE-1))]}"
    elif [ "$CHOICE" == "0" ]; then
      printf "Type the format manually ${RED}- e.g. mp4:${NC} "
      read TARGET_EXT
    else
      TARGET_EXT="$CHOICE"
    fi
    
    TARGET_EXT=${TARGET_EXT#.}
    TARGET_EXT=$(echo "$TARGET_EXT" | tr '[:upper:]' '[:lower:]')
    printf "\n"

    if [[ "$TYPE" == "video" || "$TYPE" == "audio" || "$TYPE" == "image" ]]; then
      printf "Do you want to compress the file? ${RED}- y/n:${NC} "
      read DO_COMPRESS
      printf "\n"
    fi

  elif [ "$ACTION_CHOICE" == "2" ]; then
    TARGET_EXT="$EXT"
    if [[ "$TYPE" == "video" || "$TYPE" == "audio" || "$TYPE" == "image" ]]; then
      DO_COMPRESS="y"
    else
      printf "${YELLOW}Compression is not natively supported for %s files. Duplicating instead.${NC}\n\n" "$TYPE"
      DO_COMPRESS="n"
    fi
  else
    printf "${RED}Invalid choice!${NC}\n\n"
    continue
  fi

  if [[ "$DO_COMPRESS" =~ ^[Yy]$ ]]; then
    printf "${BOLD}${CYAN}Choose compression method:${NC}\n\n"
    printf "  1. By Percentage %%\n\n"
    printf "  2. By Target Size\n\n"
    printf "Choice: "
    read COMP_METHOD
    printf "\n"

    if [ "$COMP_METHOD" == "1" ]; then
      printf "${BOLD}${CYAN}Choose compression level:${NC}\n\n"
      printf "  1. High Quality ${RED}- Light compression, ~ 20%% reduction${NC}\n\n"
      printf "  2. Medium Quality ${RED}- Balanced, ~ 50%% reduction${NC}\n\n"
      printf "  3. Low Quality ${RED}- Heavy compression, ~ 80%% reduction${NC}\n\n"
      printf "  0. Custom Percentage\n\n"
      printf "Choice: "
      read COMP_CHOICE
      printf "\n"

      case "$COMP_CHOICE" in
        1) COMP_PERCENT=20 ;;
        2) COMP_PERCENT=50 ;;
        3) COMP_PERCENT=80 ;;
        0) printf "Enter custom compression percentage ${RED}- 1 to 100:${NC} "; read COMP_PERCENT; printf "\n" ;;
        *) printf "Invalid. Defaulting to 50%%.\n\n"; COMP_PERCENT=50 ;;
      esac
    elif [ "$COMP_METHOD" == "2" ]; then
      printf "${BOLD}${CYAN}Select Target Size:${NC}\n\n"
      printf "  1. 8 MB\n\n"
      printf "  2. 25 MB\n\n"
      printf "  3. 50 MB\n\n"
      printf "  4. 100 MB\n\n"
      printf "  5. Custom Value\n\n"
      printf "Choice: "
      read TS_CHOICE
      printf "\n"

      case "$TS_CHOICE" in
        1) TARGET_KB=$((8 * 1024)) ;;
        2) TARGET_KB=$((25 * 1024)) ;;
        3) TARGET_KB=$((50 * 1024)) ;;
        4) TARGET_KB=$((100 * 1024)) ;;
        5)
          printf "${BOLD}${CYAN}Select Unit:${NC}\n\n"
          printf "  1. KB\n\n"
          printf "  2. MB\n\n"
          printf "  3. GB\n\n"
          printf "Choice: "
          read UNIT_CHOICE
          printf "\n"
          
          printf "Enter the numerical value: "
          read CUSTOM_NUM
          printf "\n"
          
          if [ "$UNIT_CHOICE" == "1" ]; then TARGET_KB=$CUSTOM_NUM
          elif [ "$UNIT_CHOICE" == "2" ]; then TARGET_KB=$((CUSTOM_NUM * 1024))
          elif [ "$UNIT_CHOICE" == "3" ]; then TARGET_KB=$((CUSTOM_NUM * 1024 * 1024))
          else TARGET_KB=$((CUSTOM_NUM * 1024)); fi
          ;;
        *) 
          printf "Invalid choice. Defaulting to 25 MB.\n\n"
          TARGET_KB=$((25 * 1024))
          ;;
      esac
    else
      printf "${YELLOW}Invalid choice. Skipping compression.${NC}\n\n"
    fi
  fi

  # Advanced Settings
  if [[ "$TYPE" == "video" || "$TYPE" == "audio" ]]; then
    printf "${BOLD}${CYAN}Advanced Settings${NC}\n\n"
    printf "Leave blank and press Enter to skip, or type numbers separated by comma ${RED}- e.g. 1,4${NC}\n\n"
    if [[ "$TYPE" == "video" ]]; then
      printf "  1. Process Audio Only ${RED}- keep original video and modify sound${NC}\n\n"
      printf "  2. Remove Audio Track ${RED}- strip audio from video${NC}\n\n"
      printf "  3. Keep Original FPS ${RED}- prevent framerate drops${NC}\n\n"
    fi
    printf "  4. Trim Media Length ${RED}- remove seconds from start or end${NC}\n\n"
    printf "Choices: "
    read ADV_OPTS
    printf "\n"

    if [[ "$ADV_OPTS" == *"1"* && "$TYPE" == "video" ]]; then ADV_AUDIO_ONLY_COMPRESS=true; fi
    if [[ "$ADV_OPTS" == *"2"* && "$TYPE" == "video" ]]; then ADV_MUTE=true; fi
    if [[ "$ADV_OPTS" == *"3"* && "$TYPE" == "video" ]]; then ADV_PRESERVE_FPS=true; fi
    if [[ "$ADV_OPTS" == *"4"* ]]; then
        ADV_TRIM=true
        printf "Seconds to remove from the START ${RED}- Enter 0 to skip:${NC} "
        read TRIM_START
        printf "Seconds to remove from the END ${RED}- Enter 0 to skip:${NC} "
        read TRIM_END
        printf "\n"
    fi
  fi

  OUTPUT_FILE="${FILENAME}_converted.${TARGET_EXT}"
  CMD=""
  ARGS=""

  IS_TARGET_AUDIO=false
  if [[ "mp3 wav flac m4a aac ogg wma opus" =~ "$TARGET_EXT" ]]; then
    IS_TARGET_AUDIO=true
  fi

  TOTAL_SEC=0
  USE_REAL_PROGRESS=false
  FFMPEG_LOG="/tmp/ffmpeg_progress.log"
  rm -f "$FFMPEG_LOG"

  printf "${MAGENTA}Preparing engines...${NC}\n\n"
  sleep 1
  
  # Calculate Original Size Before Execution for calculations
  ORIG_BYTES=$(stat -c%s "$FILE" 2>/dev/null || stat -f%z "$FILE" 2>/dev/null)
  if [ -z "$ORIG_BYTES" ]; then ORIG_BYTES=0; fi

  # ==========================================
  # STRICT ENGINE ROUTING (Error-Free Zone)
  # ==========================================

  # 1. FFmpeg (Video/Audio + GIF)
  if [[ " 3gp aac ac3 aiff apng asf avi f4v flac flv gif m4a m4v mka mkv mov mp2 mp3 mp4 mpeg oga ogv opus ts wav webm wma wmv " =~ " $TARGET_EXT " ]] && [[ "$TYPE" == "video" || "$TYPE" == "audio" ]]; then
    if [ "$IS_TARGET_AUDIO" = true ] && [ "$EXT" != "$TARGET_EXT" ]; then
      ARGS="-vn "
    fi

    if command -v ffprobe &> /dev/null; then
      TOTAL_SEC=$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$FILE" 2>/dev/null | awk '{print int($1)}')
      if [[ -n "$TOTAL_SEC" && "$TOTAL_SEC" -gt 0 ]]; then
        USE_REAL_PROGRESS=true
        
        if [ "$ADV_TRIM" = true ]; then
            TOTAL_SEC=$((TOTAL_SEC - TRIM_START - TRIM_END))
            if [ "$TOTAL_SEC" -le 0 ]; then TOTAL_SEC=1; fi
        fi
      fi
    fi

    if [ "$ADV_TRIM" = true ] && [ "$TRIM_START" -gt 0 ]; then
        ARGS+="-ss $TRIM_START "
    fi

    if [ "$ADV_MUTE" = true ]; then
        ARGS+="-an "
    elif [ "$ADV_AUDIO_ONLY_COMPRESS" = true ]; then
        ARGS+="-c:v copy "
    fi

    if [[ "$TYPE" == "video" && "$ADV_PRESERVE_FPS" == false && "$DO_COMPRESS" =~ ^[Yy]$ && "$ADV_AUDIO_ONLY_COMPRESS" == false ]]; then
        ARGS+="-r 30 "
    fi

    if [[ "$DO_COMPRESS" =~ ^[Yy]$ ]]; then
      if [ "$COMP_METHOD" == "1" ] && [ -n "$COMP_PERCENT" ]; then
        if [ "$IS_TARGET_AUDIO" = false ]; then
          if [ "$ADV_AUDIO_ONLY_COMPRESS" == false ]; then
              CRF=$(( 18 + (COMP_PERCENT * 33 / 100) ))
              ARGS+="-c:v libx264 -crf $CRF -preset fast "
          fi
          if [ "$ADV_MUTE" == false ]; then
              ARGS+="-b:a 128k "
          fi
        else
          BR=$(( 64 + ((100 - COMP_PERCENT) * 256 / 100) ))
          ARGS+="-b:a ${BR}k "
        fi
      elif [ "$COMP_METHOD" == "2" ] && [ -n "$TARGET_KB" ]; then
        if [ "$USE_REAL_PROGRESS" = true ]; then
          TOTAL_BITRATE=$(( (TARGET_KB * 8) / TOTAL_SEC ))
          
          if [ "$IS_TARGET_AUDIO" = false ]; then
            if [ "$ADV_MUTE" = true ]; then AUDIO_BR=0; else AUDIO_BR=64; ARGS+="-b:a ${AUDIO_BR}k "; fi
            V_BITRATE=$(( TOTAL_BITRATE - AUDIO_BR ))
            if [ $V_BITRATE -lt 50 ]; then V_BITRATE=50; fi
            if [ "$ADV_AUDIO_ONLY_COMPRESS" == false ]; then
                ARGS+="-b:v ${V_BITRATE}k -maxrate ${V_BITRATE}k -bufsize $((V_BITRATE*2))k "
            fi
          else
            ARGS+="-b:a ${TOTAL_BITRATE}k "
          fi
        else
          ARGS+="-c:v libx264 -crf 30 -preset fast "
        fi
      fi
    fi

    if [ "$ADV_TRIM" = true ] && [ "$TRIM_END" -gt 0 ]; then
        ARGS+="-t $TOTAL_SEC "
    fi
    
    if [ "$USE_REAL_PROGRESS" = true ]; then
      CMD="ffmpeg -i \"$FILE\" $ARGS -progress \"$FFMPEG_LOG\" -nostats \"$OUTPUT_FILE\" -y"
    else
      CMD="ffmpeg -i \"$FILE\" $ARGS \"$OUTPUT_FILE\" -y"
    fi

  # 2. ImageMagick (Images + PDF to Image)
  elif [[ " apng bmp dds dib eps gif heic heif icns ico jp2 jpeg jxl pbm pcx pfm pgm png pnm ppm psd sgi svg tga tiff webp xbm xpm pdf " =~ " $TARGET_EXT " ]] && [[ "$TYPE" == "image" || "$EXT" == "pdf" ]]; then
    if [[ "$DO_COMPRESS" =~ ^[Yy]$ ]]; then
      if [ "$COMP_METHOD" == "1" ] && [ -n "$COMP_PERCENT" ]; then
        QUAL=$(( 100 - COMP_PERCENT ))
        if [ "$QUAL" -lt 1 ]; then QUAL=1; fi
        ARGS="-quality $QUAL"
      elif [ "$COMP_METHOD" == "2" ] && [ -n "$TARGET_KB" ]; then
        ORIG_KB=$((ORIG_BYTES / 1024))
        if [ -n "$ORIG_KB" ] && [ "$ORIG_KB" -gt 0 ]; then
            QUAL=$(( (TARGET_KB * 100) / ORIG_KB ))
            if [ "$QUAL" -gt 100 ]; then QUAL=100; fi
            if [ "$QUAL" -lt 1 ]; then QUAL=1; fi
        else
            QUAL=50
        fi
        ARGS="-quality $QUAL -define jpeg:extent=${TARGET_KB}kb -define webp:extent=${TARGET_KB}kb"
      fi
    fi
    CMD="magick -density 300 \"$FILE\" $ARGS \"$OUTPUT_FILE\""

  # 3. Native Linux Archive (Zip/Tar)
  elif [[ " zip cbz tar tar.gz tar.bz2 tar.xz tgz " =~ " $TARGET_EXT " ]]; then
    if [[ "$FILE" = /* ]]; then ABS_FILE="$FILE"; else ABS_FILE="$PWD/$FILE"; fi
    if [[ "$OUTPUT_FILE" = /* ]]; then ABS_OUTPUT="$OUTPUT_FILE"; else ABS_OUTPUT="$PWD/$OUTPUT_FILE"; fi
    
    CMD="TEMP_DIR=\$(mktemp -d) && "
    
    if [[ "$EXT" == "zip" || "$EXT" == "cbz" ]]; then
      CMD+="unzip -q \"\$ABS_FILE\" -d \"\$TEMP_DIR\" && "
    elif [[ "$EXT" == "tar" ]]; then
      CMD+="tar -xf \"\$ABS_FILE\" -C \"\$TEMP_DIR\" && "
    elif [[ "$EXT" == "tar.gz" || "$EXT" == "tgz" ]]; then
      CMD+="tar -xzf \"\$ABS_FILE\" -C \"\$TEMP_DIR\" && "
    elif [[ "$EXT" == "tar.bz2" ]]; then
      CMD+="tar -xjf \"\$ABS_FILE\" -C \"\$TEMP_DIR\" && "
    elif [[ "$EXT" == "tar.xz" ]]; then
      CMD+="tar -xJf \"\$ABS_FILE\" -C \"\$TEMP_DIR\" && "
    fi

    CMD+="(cd \"\$TEMP_DIR\" && "
    if [[ "$TARGET_EXT" == "zip" || "$TARGET_EXT" == "cbz" ]]; then
      CMD+="zip -rq \"\$ABS_OUTPUT\" .) && rm -rf \"\$TEMP_DIR\""
    elif [[ "$TARGET_EXT" == "tar" ]]; then
      CMD+="tar -cf \"\$ABS_OUTPUT\" .) && rm -rf \"\$TEMP_DIR\""
    elif [[ "$TARGET_EXT" == "tar.gz" || "$TARGET_EXT" == "tgz" ]]; then
      CMD+="tar -czf \"\$ABS_OUTPUT\" .) && rm -rf \"\$TEMP_DIR\""
    elif [[ "$TARGET_EXT" == "tar.bz2" ]]; then
      CMD+="tar -cjf \"\$ABS_OUTPUT\" .) && rm -rf \"\$TEMP_DIR\""
    elif [[ "$TARGET_EXT" == "tar.xz" ]]; then
      CMD+="tar -cJf \"\$ABS_OUTPUT\" .) && rm -rf \"\$TEMP_DIR\""
    fi

  # 4. Calibre (E-books + PDF to Ebook)
  elif [[ " epub mobi azw3 fb2 kepub lrf pdb snb " =~ " $TARGET_EXT " ]] || [[ "$TYPE" == "ebook" && " epub mobi azw3 fb2 kepub lrf pdb snb docx rtf txt pdf " =~ " $TARGET_EXT " ]]; then
    CMD="ebook-convert \"$FILE\" \"$OUTPUT_FILE\""

  # 5. PYTHON DATA ENGINE (Data & Spreadsheets)
  elif [[ " csv tsv json jsonl parquet xlsx xml html md " =~ " $TARGET_EXT " ]] && [[ "$TYPE" == "data" || "$TYPE" == "spreadsheet" ]]; then
    printf "${MAGENTA}Starting Python Data Engine...${NC}\n"
    
    PYTHON_SCRIPT="/tmp/tconvert_data_engine.py"
    cat << 'EOF' > "$PYTHON_SCRIPT"
import sys
try:
    import pandas as pd
except ImportError:
    print("Error: Pandas library is not installed. Please run: pip install pandas openpyxl pyarrow lxml")
    sys.exit(1)

def convert(input_path, output_path):
    ext_in = input_path.split('.')[-1].lower()
    ext_out = output_path.split('.')[-1].lower()
    
    try:
        if ext_in in ['csv']:
            df = pd.read_csv(input_path)
        elif ext_in in ['tsv']:
            df = pd.read_csv(input_path, sep='\t')
        elif ext_in == 'json':
            try: df = pd.read_json(input_path)
            except: df = pd.read_json(input_path, lines=True)
        elif ext_in == 'jsonl':
            df = pd.read_json(input_path, lines=True)
        elif ext_in in ['xls', 'xlsx']:
            df = pd.read_excel(input_path)
        elif ext_in == 'parquet':
            df = pd.read_parquet(input_path)
        elif ext_in == 'xml':
            df = pd.read_xml(input_path)
        elif ext_in == 'html':
            df = pd.read_html(input_path)[0]
        else:
            print(f"Unsupported input data format: {ext_in}")
            sys.exit(1)
            
        if ext_out == 'csv':
            df.to_csv(output_path, index=False)
        elif ext_out == 'tsv':
            df.to_csv(output_path, sep='\t', index=False)
        elif ext_out == 'json':
